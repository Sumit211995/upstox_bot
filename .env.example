# Upstox index-options PAPER bot. Copy to .env (never commit .env).
# No Upstox login is needed: prices come from Upstox's free public API. The bot never places orders.
INDICES=NIFTY,BANKNIFTY,SENSEX,MIDCPNIFTY
# paper capital per strategy book (₹)
PAPER_CAPITAL=200000
# lots per trade
LOTS=1
# how often to check during market hours (seconds)
POLL_SECONDS=20
# Telegram: the same bot as delta_bot is fine.
# Keep comments on their own line: docker reads "KEY=   # note" as the value "# note".
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# OPTIONAL, free: Upstox "Analytics token" (read-only market data, valid 1 year, cannot place orders).
# Gives REAL live option prices + greeks for open paper positions instead of estimates. Never share it.
UPSTOX_ANALYTICS_TOKEN=
